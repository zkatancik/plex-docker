# Ignore everything by default
/*

# Allow essential repo files
!.gitignore
!.dockerignore
!docker-compose.yml
!README.md
!LICENSE
!.github/
!.github/workflows/
!.github/workflows/docker-download-cleanup.yml
!containers/
!containers/download-cleanup/
!containers/download-cleanup/**
!scripts/
scripts/*
!scripts/download-cleanup.py
!scripts/media-normalizer.py
!scripts/qb-port-sync.py
!scripts/plex-docker-recover.sh
!scripts/docker_storage_location.py
!scripts/startup_check_supervisor.py
!scripts/daily-storage-maintenance.sh
!scripts/ssd-storage-maintenance.py
!scripts/request-protected-ssd-audit.py
!scripts/protected-ssd-reader.py
!scripts/torrent_restore_hardlinks.py
!scripts/docker-settings-reader/
scripts/docker-settings-reader/*
!scripts/docker-settings-reader/main.swift
!scripts/docker-settings-reader/build.sh
!scripts/docker-settings-reader/Info.plist
!scripts/docker-settings-reader/entitlements.plist
!scripts/docker-stack-guardian.sh
!scripts/home-memory-monitor/
scripts/home-memory-monitor/*
!scripts/home-memory-monitor/home-memory.plugin
!scripts/home-memory-monitor/test_monitor.py
!scripts/home-memory-monitor/README.md
!scripts/home-memory-monitor/statsd-hook.zsh
!scripts/codex-memory-maintenance/
scripts/codex-memory-maintenance/*
!scripts/codex-memory-maintenance/policy.h
!scripts/codex-memory-maintenance/policy.m
!scripts/codex-memory-maintenance/main.m
!scripts/codex-memory-maintenance/tests.m
!scripts/codex-memory-maintenance/vendor-hosts.m
!scripts/codex-memory-maintenance/vendor-hosts-tests.m
!scripts/codex-memory-maintenance/build-install.sh
!scripts/codex-memory-maintenance/README.md
!scripts/codex-memory-maintenance/launchagent.plist.in
!scripts/codex-memory-maintenance/config.example.json
!scripts/memory-coordinator/
scripts/memory-coordinator/*
!scripts/memory-coordinator/com.zack.home-memory-coordinator.plist
!scripts/memory-coordinator/warning_policy.py
!scripts/memory-coordinator/test_warning_policy.py
!scripts/memory-coordinator/test_capacity_bypass_review.py
!scripts/memory-coordinator/test_queued_heartbeat.py
!scripts/memory-coordinator/WARNING_POLICY.md
!tests/
!tests/**
tests/__pycache__/

# Track the LaunchAgent template, but never runtime state, diagnostics, or logs.
!launchd/
launchd/*
!launchd/com.zkatancik.plex-media-normalizer.plist
!launchd/com.zack.plex-docker-recover.plist
!launchd/com.zack.docker-stack-guardian.plist
!docs/
docs/*
!docs/docker-stack-guardian.md
!docs/plex-stack-repair.md
media-normalizer/

# Track the non-secret Recyclarr policy while leaving its runtime cache,
# logs, state, and any local secrets ignored.
!recyclarr/
recyclarr/*
!recyclarr/configs/
recyclarr/configs/*
!recyclarr/configs/media.yml

# Never track local environment files
.env
.env.*

.DS_Store

!agregarr/
agregarr/*
!agregarr/trailer-audit.sh
