# Ignore everything by default
/*

# Allow essential repo files
!.gitignore
!.dockerignore
!docker-compose.yml
!README.md
!LICENSE
!.github/
!.github/workflows/
!.github/workflows/docker-download-cleanup.yml
!containers/
!containers/download-cleanup/
!containers/download-cleanup/**
!scripts/
scripts/*
!scripts/download-cleanup.py
!scripts/media-normalizer.py
!scripts/qb-port-sync.py
!scripts/plex-docker-recover.sh
!scripts/docker-stack-guardian.sh
!tests/
!tests/**
tests/__pycache__/

# Track the LaunchAgent template, but never runtime state, diagnostics, or logs.
!launchd/
launchd/*
!launchd/com.zkatancik.plex-media-normalizer.plist
!launchd/com.zack.plex-docker-recover.plist
!launchd/com.zack.docker-stack-guardian.plist
!docs/
docs/*
!docs/docker-stack-guardian.md
!docs/plex-stack-repair.md
media-normalizer/

# Track the non-secret Recyclarr policy while leaving its runtime cache,
# logs, state, and any local secrets ignored.
!recyclarr/
recyclarr/*
!recyclarr/configs/
recyclarr/configs/*
!recyclarr/configs/media.yml

# Never track local environment files
.env
.env.*
